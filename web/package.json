    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^27.4.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "^4.1.12"
  }
}
